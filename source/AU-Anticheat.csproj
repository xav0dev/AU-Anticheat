<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AU-Anticheat</AssemblyName>
    <Product>AU-Anticheat</Product>
    <Version>1.0.0-beta.2</Version>
    <AssemblyVersion>0.9.0.2</AssemblyVersion>
    <FileVersion>0.9.0.2</FileVersion>
	<DebugType>none</DebugType>
	<DebugSymbols>false</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>AUAnticheat</RootNamespace>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
      <Compile Include="ui\sections\SelfSection.cs" />
    <Compile Include="ui\sections\LobbySettingsSection.cs" />
  </ItemGroup>

  <!-- Build against the interop generated by the target game's BepInEx install.
       Do not silently fall back to pre-Influencer game libraries. -->
  <ItemGroup>
    <Reference Include="$(GameDirectory)/BepInEx/interop/*.dll" Private="false" />
    <Reference Include="$(GameDirectory)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDirectory)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDirectory)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDirectory)/BepInEx/core/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="RequireGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDirectory)' == '' Or !Exists('$(GameDirectory)/BepInEx/interop/Assembly-CSharp.dll')"
           Text="Set -p:GameDirectory to your Among Us v19 installation after BepInEx has generated its interop libraries." />
  </Target>

  <!-- Defensive-only allowlist. Upstream utility/trolling source is not built. -->
  <ItemGroup>
    <Compile Include="AUAnticheatPlugin.cs" />
    <Compile Include="Utilities.cs" />
    <Compile Include="anticheat\**\*.cs" />
    <Compile Include="features\Protections.cs" />
    <Compile Include="network\DataHandler.cs" />
    <Compile Include="network\Constants.cs" />
    <Compile Include="ui\MainUI.cs" />
    <Compile Include="ui\InlineEditor.cs" />
    <Compile Include="ui\WardrobeEditor.cs" />
    <Compile Include="ui\RulesEditor.cs" />
    <Compile Include="ui\ModerationTools.cs" />
    <Compile Include="ui\LoadoutsEditor.cs" />
    <Compile Include="ui\sections\LobbySection.cs" />
    <Compile Include="ui\Notification.cs" />
    <Compile Include="ui\NotificationManager.cs" />
    <Compile Include="ui\Styles.cs" />
    <Compile Include="ui\PlayerPresentation.cs" />
    <Compile Include="ui\GameFont.cs" />
	<Compile Include="ui\StatusIndicator.cs" />
    <Compile Include="ui\sections\ISection.cs" />
    <Compile Include="ui\sections\GeneralSection.cs" />
    <Compile Include="ui\sections\ModeratorSection.cs" />
    <Compile Include="ui\sections\ExceptionsSection.cs" />
    <Compile Include="ui\sections\ProtectionsSection.cs" />
    <Compile Include="ui\sections\AnticheatSection.cs" />
	<Compile Include="ui\sections\NotificationsSection.cs" />
    <Compile Include="ui\sections\MenuSection.cs" />
  </ItemGroup>
</Project>
